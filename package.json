    "test:cpp": "node scripts/test-cpp.js"
  },
  "peerDependencies": {
    "react": "*",
    "react-native": ">=0.78.0",
    "react-native-nitro-modules": ">=0.35.8"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "jest": "^30.4.2",
    "nitrogen": "*",
    "react": "*",
    "react-native": "*",
    "react-native-nitro-modules": ">=0.35.8",
    "subset-font": "^2.9.0",
    "ts-jest": "^29.4.11",
    "typescript": "5.4.5"
  },
  "files": [
    "src",
    "!src/__tests__",
    "cpp",
    "!cpp/tests",
    "android",
    "ios",
    "scripts",
    "Package.swift",
    "nitro.json",
    "nitrogen",
    "NitroPdfWriter.podspec",
    "LICENSE",
    "NOTICE",
    "README.md"
  ],
  "packageManager": "yarn@4.17.1"

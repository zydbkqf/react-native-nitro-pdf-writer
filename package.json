{
  "name": "react-native-nitro-pdf-writer",
  "version": "0.1.4",
  "description": "Fast PDF file writing for React Native using libHaru and Nitro Modules",
  "license": "MIT",
  "homepage": "https://github.com/zydbkqf/react-native-nitro-pdf-writer",
  "author": "Denis Cheung (https://github.com/zydbkqf)",
  "type": "module",
  "main": "src/index.ts",
